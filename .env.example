# === Google Tasks API ===
GOOGLE_TASKS_API_KEY=your_google_tasks_api_key_here

# === Google OAuth2 Credentials (for Tasks + Drive) ===
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
# This gets auto-populated after first OAuth flow
GOOGLE_REFRESH_TOKEN=

# === Google Drive ===
# Folder ID of the root Google Drive folder where book folders will be created
# Create a folder in Drive, then grab the ID from the URL
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_folder_id_here

# === OpenAI API (for summaries / podcast generation) ===
OPENAI_API_KEY=your_openai_api_key_here

# === Kokoro TTS ===
# Kokoro model path (local) or API endpoint
KOKORO_MODEL_PATH=./models/kokoro
# OR use a hosted endpoint:
# KOKORO_API_URL=http://localhost:8880/v1

# === Book Search ===
# Open Library is free (no key needed)
# Optional: Google Books API key for richer search
GOOGLE_BOOKS_API_KEY=

# === Paths ===
# Local staging directory before uploading to Drive
LOCAL_STAGING_DIR=./staging
# State file tracking processed tasks
STATE_FILE=./state/processed_tasks.json
